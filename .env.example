# Clarity SaaS — server environment
# Local Postgres or Neon/Render/Supabase connection string.
DATABASE_URL=postgresql://clarity:clarity@localhost:5432/clarity

# Public origin used for cookies, same-origin checks and links.
APP_URL=http://localhost:8787

# Node server port and environment.
PORT=8787
NODE_ENV=development

# Optional: Vite dev proxy target (defaults to http://localhost:8787).
# VITE_API_PROXY=http://localhost:8787
